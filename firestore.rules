rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só os dois e-mails abaixo podem ler e escrever. Troque pelo e-mail real da Bru.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['flavkb@gmail.com', 'EMAIL_DA_BRU@exemplo.com'];
    }
  }
}
